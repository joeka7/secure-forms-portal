# Secure Forms Portal: environment template.
#
# Copy to .env.local (git-ignored) and adjust:   cp .env.example .env.local
# Every variable is optional for the app to start. Never commit real credentials.

# ---------------------------------------------------------------------------------------------
# Demo data (local development only)
# ---------------------------------------------------------------------------------------------

# Optional. "true" creates the fictional demo users, category assignments and sample submissions
# on first start. Do not enable this in a real deployment.
PORTAL_SEED_DEMO=true

# Required when PORTAL_SEED_DEMO=true. Password for every demo account, at least 10 characters.
# Choose your own value: there is deliberately no default. If it is empty or too short, the demo
# data is skipped and a warning is logged. Only used when the demo accounts are first created.
PORTAL_DEMO_PASSWORD=

# ---------------------------------------------------------------------------------------------
# First administrator (real deployments)
# ---------------------------------------------------------------------------------------------

# Optional. Creates the first administrator while no administrator exists, then is ignored.
# The password must be at least 10 characters. Remove both values after the first sign-in.
# PORTAL_BOOTSTRAP_ADMIN_EMAIL=admin@your-company.example
# PORTAL_BOOTSTRAP_ADMIN_PASSWORD=
# Optional display name for that administrator. Default: Administrator
# PORTAL_BOOTSTRAP_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------------------------
# Runtime settings
# ---------------------------------------------------------------------------------------------

# Optional. SQLite database file. Default: .data/portal.sqlite (git-ignored).
# In production, point this at persistent storage.
# PORTAL_DB_PATH=.data/portal.sqlite

# Optional. IANA time zone used to display timestamps and to interpret the submission date
# filters (whole days). Invalid values fall back to UTC with a warning. Default: UTC
# PORTAL_TIMEZONE=Europe/London

# Optional. Number of trusted reverse proxies in front of the app (0–10), used to read the client
# IP from X-Forwarded-For for per-IP login throttling. Default: 0, which ignores forwarded headers
# (they can be forged) and makes per-IP throttling apply to all clients together.
# Set it to the real number of proxies in production, e.g. 1 behind a single load balancer.
# PORTAL_TRUSTED_PROXY_HOPS=1

# Optional. Session cookies are Secure whenever NODE_ENV=production. Set to false only to test a
# production build over plain HTTP on a host other than localhost. Default: unset
# PORTAL_COOKIE_SECURE=false
